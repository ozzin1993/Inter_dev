  m_Script: {fileID: 11500000, guid: e15fcca452434ea4c96c2cd743b313b0, type: 3}
  m_Name: Gurtag_FelRam
  m_EditorClassIdentifier: Interflow.Game::StrategyCore.CompositeSkill
  id: 113
  abilityName:
  - "\u0422\u0430\u0440\u0430\u043D \u0421\u043A\u0432\u0435\u0440\u043D\u044B"
  description:
  - "\u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0440\u044B\u0432\u043E\u043A
    \u0432\u043E \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0439 \u0441\u0442\u0440\u043E\u0439,
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0438 \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439
    \u0443\u0440\u043E\u043D, \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u0435
    \u043F\u0435\u0445\u043E\u0442\u044B \u04221\u2013\u04223. \u0410\u043B\u044C\u0444\u0430:
    CD10\u0441, \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C5\u043C, \u0440\u0430\u0434\u0438\u0443\u04412\u043C,
    40\u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E+30\u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043E\u0433\u043D\u0451\u043C, \u0440\u044B\u0432\u043E\u043A0.45\u0441, \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u04352\u043C.
    \u0417\u0432\u0435\u0440\u0438 \u0438 \u043C\u0430\u0448\u0438\u043D\u044B \u043D\u0435
    \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u044E\u0442\u0441\u044F."
