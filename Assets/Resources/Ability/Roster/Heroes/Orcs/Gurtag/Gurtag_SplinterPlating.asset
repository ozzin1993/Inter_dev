  abilityName:
  - "\u041E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u0430\u044F \u043E\u0431\u0448\u0438\u0432\u043A\u0430"
  description:
  - "\u041A\u0430\u0436\u0434\u044B\u0439 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0439
    \u043F\u0440\u044F\u043C\u043E\u0439 \u0443\u0434\u0430\u0440 \u0432 \u0431\u043B\u0438\u0436\u043D\u0435\u043C
    \u0431\u043E\u044E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
    \u0430\u0442\u0430\u043A\u0443\u044E\u0449\u0435\u043C\u044310\u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0443\u0440\u043E\u043D\u0430. \u041D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
    \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0438\u0435 \u0430\u0442\u0430\u043A\u0438,
    DoT \u0438 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432."
