  abilityName:
  - "\u0416\u0430\u0442\u0432\u0430 \u0434\u0443\u0448"
  description:
  - "\u0413\u0438\u0431\u0435\u043B\u044C \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u0441\u043E\u044E\u0437\u043D\u043E\u0433\u043E \u043E\u0440\u043A\u0430 \u043D\u0430
    \u043B\u0438\u043D\u0438\u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
    \u041A\u043E\u0440\u0433\u0430\u043B\u044325HP \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E
    \u043E\u0442 \u0443\u0431\u0438\u0439\u0446\u044B. \u041D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
    \u043D\u0430 \u043B\u044E\u0434\u0435\u0439, \u0437\u0432\u0435\u0440\u0435\u0439,
    \u043E\u0433\u0440\u043E\u0432 \u0438 \u043E\u0441\u0430\u0434\u043D\u044B\u0435
    \u043C\u0430\u0448\u0438\u043D\u044B."
