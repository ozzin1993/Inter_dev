  m_Name: Korgal_SacrificialBonfire
  m_EditorClassIdentifier: Interflow.Game::StrategyCore.CompositeSkill
  id: 110
  abilityName:
  - "\u041E\u0431\u0440\u044F\u0434 \u0416\u0435\u0440\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u041A\u043E\u0441\u0442\u0440\u0430"
  description:
  - "CD40\u0441, \u0446\u0435\u043D\u043020%\u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043EHP.
    \u0421\u043E\u044E\u0437\u043D\u044B\u0435 \u043E\u0440\u043A\u0438 \u0442\u0435\u043A\u0443\u0449\u0435\u0439
    \u0432\u043E\u043B\u043D\u044B \u0433\u043E\u0440\u044F\u04426\u0441: \u0432\u0440\u0430\u0433\u0430\u043C
    \u0432\u043E\u043A\u0440\u0443\u043315\u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E/\u0441,
    \u0441\u0435\u0431\u04355HP/\u0441, \u043F\u0440\u0438 \u0433\u0438\u0431\u0435\u043B\u043840AoE.
    \u0410\u043B\u044C\u0444\u0430: \u0430\u0443\u0440\u04302\u043C \u0441\u0432\u0435\u0440\u0445
    \u0440\u0430\u0437\u043C\u0435\u0440\u0430, \u0432\u0437\u0440\u044B\u04322\u043C
    \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439; \u0437\u0432\u0435\u0440\u0438,
    \u043E\u0433\u0440\u044B \u0438 \u043C\u0430\u0448\u0438\u043D\u044B \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u044B."
