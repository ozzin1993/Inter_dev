  abilityName:
  - "\u041F\u0440\u043E\u0440\u044B\u0432 \u0432 \u0442\u044B\u043B"
  description:
  - "\u0420\u0430\u0437\u0433\u043E\u043D\u044F\u0435\u0442\u0441\u044F \u043A \u043C\u0430\u0433\u0443
    \u0432 \u0442\u044B\u043B\u0443; \u043F\u0440\u0438 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438
    \u043C\u0430\u0433\u0430 \u2014 \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0443. \u041E\u0441\u043A\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044B\u0439
    \u041F\u0440\u043E\u0440\u044B\u0432: \u043F\u0435\u0440\u0432\u044B\u0439 \u0443\u0434\u0430\u0440
    \u043F\u043E\u0441\u043B\u0435 \u0440\u0430\u0437\u0433\u043E\u043D\u0430 \u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442
    \u043D\u0430 1.5 \u0441. \u0410\u043B\u044C\u0444\u0430: \u043E\u0442\u043A\u0430\u04428\u0441,
    \u043F\u043E\u0438\u0441\u043A8\u043C, \u043C\u0438\u043D\u0438\u043C\u0443\u043C3\u043C,
    \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C+80%, \u0440\u0430\u0437\u0433\u043E\u043D3\u0441."
