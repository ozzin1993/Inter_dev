  m_Script: {fileID: 11500000, guid: e15fcca452434ea4c96c2cd743b313b0, type: 3}
  m_Name: OrcSlaver_Whip
  m_EditorClassIdentifier: Interflow.Game::StrategyCore.CompositeSkill
  id: 60
  abilityName:
  - "\u0423\u0434\u0430\u0440 \u041A\u043D\u0443\u0442\u043E\u043C"
  description:
  - "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u041E\u0440\u043A, \u0412\u043E\u043B\u043A
    \u0438\u043B\u0438 \u041E\u0433\u0440 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
    \u0442\u0435\u0440\u044F\u0435\u0442 15% \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
    +40% \u0443\u0440\u043E\u043D\u0430 \u0430\u0442\u0430\u043A\u0438 \u043D\u0430
    5 \u0441\u0435\u043A\u0443\u043D\u0434. \u0418\u0437\u043D\u0443\u0440\u044F\u044E\u0449\u0430\u044F
    \u041F\u043B\u0435\u0442\u044C: +25% \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
    \u0430\u0442\u0430\u043A\u0438. \u0416\u0435\u0440\u0442\u0432\u043E\u043F\u0440\u0438\u043D\u043E\u0448\u0435\u043D\u0438\u0435
    \u0412\u043E\u0436\u0434\u044F: \u0433\u0438\u0431\u0435\u043B\u044C \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044F
    \u043B\u0435\u0447\u0438\u0442 \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430
    \u043D\u0430 50% \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0438 \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
    \u043E\u0442\u043A\u0430\u0442."
