  m_Name: FelFireHurler_UnquenchableFlame
  m_EditorClassIdentifier: Interflow.Game::StrategyCore.CompositePassive
  id: 70
  abilityName:
  - "\u041D\u0435\u0433\u0430\u0441\u0438\u043C\u043E\u0435 \u041F\u043B\u0430\u043C\u044F"
  description:
  - "\u0417\u0435\u043B\u0451\u043D\u043E\u0435 \u043F\u043B\u0430\u043C\u044F: -10%
    \u0432\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E \u043B\u0435\u0447\u0435\u043D\u0438\u044F
    \u0437\u0430 \u0441\u0442\u0430\u043A, \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C
    5. \u041D\u0430 5 \u0441\u0442\u0430\u043A\u0430\u0445 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F
    \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0431\u0440\u043E\u043D\u044E \u043D\u0430
    15%; \u0434\u0440\u0443\u0433\u0430\u044F \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442
    2 \u0441\u0442\u0430\u043A\u0430 \u0441\u043E\u0441\u0435\u0434\u044F\u043C \u043F\u0440\u0438
    \u0441\u043C\u0435\u0440\u0442\u0438. \u0414\u043B\u044F \u0430\u043B\u044C\u0444\u044B:
    4 \u0441\u0435\u043A\u0443\u043D\u0434\u044B, 3 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0443\u0440\u043E\u043D\u0430/\u0441 \u0437\u0430 \u0441\u0442\u0430\u043A,
    \u0440\u0430\u0434\u0438\u0443\u0441 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u044F
    2.5 \u043C."
