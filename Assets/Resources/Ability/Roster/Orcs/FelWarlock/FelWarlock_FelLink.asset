  m_Name: FelWarlock_FelLink
  m_EditorClassIdentifier: Interflow.Game::StrategyCore.CompositeSkill
  id: 77
  abilityName:
  - "\u0421\u043A\u0432\u0435\u0440\u043D\u043E-\u0421\u0432\u044F\u0437\u044C"
  description:
  - "\u0421\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442 \u0434\u043E 3 \u0432\u0440\u0430\u0433\u043E\u0432
    \u043D\u0430 5\u0441. 40% \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u043E\u0433\u043E
    \u043E\u0434\u043D\u0438\u043C \u0443\u0440\u043E\u043D\u0430 \u043A\u043E\u043F\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C. \u0420\u0430\u0437\u0440\u044B\u0432
    \u0414\u0443\u0448\u0438: \u0441\u043C\u0435\u0440\u0442\u044C \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0439
    \u0446\u0435\u043B\u0438 \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D
    (\u0430\u043B\u044C\u0444\u0430:40). \u0410\u043B\u044C\u0444\u0430: \u0431\u0430\u0437\u043E\u0432\u044B\u0439
    CD10\u0441, \u0441 \u043F\u0430\u0441\u0441\u0438\u0432\u043A\u043E\u04398\u0441,
    \u0440\u0430\u0434\u0438\u0443\u04413\u043C."
