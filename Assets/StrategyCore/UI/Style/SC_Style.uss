:root {
    --backgroundColor: rgb(56, 56, 56);
    --borderColor: rgb(75, 75, 75);
    --borderColorLight: rgb(87, 87, 87);
    --emptySlotBack: rgb(51, 51, 51);
    --emptySlotBorder: rgb(41, 41, 41);
    --borderOuter: rgb(58, 58, 58);
    --borderInner: rgb(114, 114, 114);
    --backgroundDark: rgb(31, 31, 31);
    --blood: rgb(214, 86, 86);
    --mana: rgb(62, 121, 183);
    --xp: rgb(145, 96, 45);
    --lifetime: rgb(158, 75, 166);
    --darkBorder: rgba(93, 93, 93, 0.95);
    --innerColor: rgba(56, 56, 56, 0.95);
    --outerColor: rgba(75, 75, 75, 0.95);
    --buttonBorder: rgba(87, 87, 87, 0.95);
    --emptyButtonBorder: rgba(44, 44, 44, 0.95);
}

.borderOuter {
    background-color: var(--borderOuter);
}

.darkTheme {
    background-color: var(--innerColor);
    border-color: var(--outerColor);
    color: rgb(255, 255, 255);
}

.backBorder {
    background-color: var(--outerColor);
}

.darkBorder {
    background-color: var(--innerColor);
    border-color: var(--emptyButtonBorder);
}

.backgroundDark {
    background-color: var(--backgroundDark);
}

.buttonColors {
    background-color: var(--outerColor);
    border-color: var(--buttonBorder);
}

.unity-label {
    margin: 0;
    padding: 0;
    color: rgb(255, 255, 255);
}

.yellow-label {
    color: rgb(243, 189, 90);
}

.playerIconInner {
    background-color: var(--borderOuter);
}

.standardBar {
    width: 110px;
    height: 16px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-width: 1px;
    border-color: var(--borderInner);
}

.standardBar .unity-progress-bar__container {
    height: 100%;
    max-height: none;
    min-height: auto;
    border-radius: 2px;
}

.standardBar .unity-progress-bar__background {
    background-color: var(--borderOuter);
    border-width: 0;
    border-radius: 2px;
}

.standardBar .unity-progress-bar__progress {
    background-color: var(--blood);
    border-radius: 2px;
    margin: 2px;
}

.standardBar .unity-progress-bar__title-container {
}

.standardBar .unity-progress-bar__title {
    font-size: 10px;
}

.healthBar .unity-progress-bar__container {
    border-radius: 300px;
}

.healthBar .unity-progress-bar__background {
    border-radius: 300px;
}

.healthBar .unity-progress-bar__progress {
    border-radius: 300px;
}

.XPBar {
    position: absolute;
    bottom: 66px;
    width: 691px;
    height: 20px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-width: 2px;
    border-color: var(--darkBorder);
}

.XPBar .unity-progress-bar__container {
    height: 100%;
    max-height: none;
    min-height: auto;
}

.XPBar .unity-progress-bar__background {
    background-color: var(--borderOuter);
    border-width: 0;
}

.XPBar .unity-progress-bar__progress {
    background-color: var(--xp);
    margin: 2px;
}

.dark-theme {
    background-color: var(--backgroundColor);
    border-color: rgb(96, 96, 96);
    color: rgb(255, 255, 255);
    border-width: 0;
}

.light-background {
    background-color: var(--secondaryColor);
}

.light-border {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--borderColorLight);
    border-right-color: var(--borderColorLight);
    border-top-color: var(--borderColorLight);
    border-bottom-color: var(--borderColorLight);
}

.border {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--borderColorLight);
    border-right-color: var(--borderColorLight);
    border-top-color: var(--borderColorLight);
    border-bottom-color: var(--borderColorLight);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
}

.custom-bar .unity-progress-bar__progress {
    margin: 2px;
    border-radius: 1px;
}

.custom-bar .unity-progress-bar__background {
    border-width: 1px 0 0 0;
    border-radius: 0;
    background-color: var(--emptyButtonBorder);
    border-color: var(--innerColor);
    margin: 0;
}

.mana-bar {
    height: auto;
    flex-grow: 0;
    align-items: stretch;
    justify-content: center;
    color: rgb(255, 255, 255);
    left: auto;
    width: auto;
    top: auto;
    bottom: auto;
    position: relative;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.hp-bar {
    height: auto;
    flex-grow: 0;
    align-items: stretch;
    justify-content: center;
    color: rgb(255, 255, 255);
    left: auto;
    width: auto;
    top: auto;
    bottom: auto;
    position: relative;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.hp-bar .unity-progress-bar__progress {
    background-color: var(--blood);
}

.mana-bar .unity-progress-bar__progress {
    background-color: var(--mana);
}

.xpbar .unity-progress-bar__progress {
    background-color: var(--xp);
}

.xpbar .unity-progress-bar__container {
    max-height: 30px;
    min-height: 30px;
}

.XPBar .unity-progress-bar__background {
    border-width: 0;
}

.lifetime-bar .unity-progress-bar__progress {
    background-color: var(--lifetime);
}

.AbilityScrollView {
    flex-grow: 0;
    flex-shrink: 0;
    width: 311px;
    height: 100%;
    min-width: auto;
    min-height: auto;
    align-items: center;
    justify-content: center;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-right: 2px;
    padding-left: 2px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    left: 7px;
}

.AbilityScrollView .unity-scroll-view__content-viewport {
}

.AbilityScrollView .unity-scroll-view__content-container {
    flex-basis: initial;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
}

.AbilityScrollView .unity-scroll-view__vertical-scroller {
    padding: 0;
    width: 15px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.AbilityScrollView .unity-scroller__low-button {
    background-color: var(--secondaryColor);
    -unity-background-image-tint-color: var(--borderColor);
    border-color: var(--borderColorLight);
    display: none;
}

.AbilityScrollView .unity-scroller__high-button {
    background-color: var(--secondaryColor);
    -unity-background-image-tint-color: var(--borderColor);
    border-color: var(--borderColorLight);
    display: none;
}

.AbilityScrollView .unity-scroller__slider {
    background-color: var(--backgroundColor);
    border-color: var(--borderColorLight);
    width: 15px;
    min-width: 15px;
    margin-top: 0;
    margin-bottom: 0;
}

.AbilityScrollView .unity-base-slider__tracker {
    background-color: var(--emptyButtonBorder);
    width: 3px;
    border-width: 0;
    margin-left: 6px;
}

.AbilityScrollView .unity-base-slider__dragger {
    background-color: var(--outerColor);
    width: 9px;
    left: 3px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-width: 0;
    border-left-width: 0;
}

.locked {
    -unity-background-image-tint-color: rgb(135, 135, 135);
    border-left-width: 6px;
    border-right-width: 6px;
    border-top-width: 6px;
    border-bottom-width: 6px;
    border-left-color: rgba(0, 0, 0, 0.41);
    border-right-color: rgba(0, 0, 0, 0.41);
    border-top-color: rgba(0, 0, 0, 0.41);
    border-bottom-color: rgba(0, 0, 0, 0.41);
}

.tester {
    -unity-background-image-tint-color: rgb(135, 135, 135);
    border-left-width: 12px;
    border-right-width: 12px;
    border-top-width: 12px;
    border-bottom-width: 12px;
    border-left-color: rgba(0, 0, 0, 0.41);
    border-right-color: rgba(0, 0, 0, 0.41);
    border-top-color: rgba(0, 0, 0, 0.41);
    border-bottom-color: rgba(0, 0, 0, 0.41);
}

.woodicon {

}

.AbilityButton {
    background-color: var(--outerColor);
    border-color: var(--buttonBorder);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-width: 2px;
    width: 68px;
    height: 68px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.AbilityButtonIcon {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
}

.ItemButton {
    background-color: var(--outerColor);
    border-color: var(--buttonBorder);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-width: 2px;
    width: 70px;
    height: 70px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.MainProcessButton {
    width: 90px;
    height: 90px;
}

.process-timer {
    position: absolute;
    bottom: 0;
    right: 0;
    background-color: var(--innerColor);
}

.charges {
    position: absolute;
    top: 0;
    left: 0;
    background-color: var(--innerColor);
}

.RightArea {
    position: absolute;
    bottom: 10px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    left: auto;
    width: 351px;
    height: 326px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    right: 10px;
    border-top-left-radius: 1px;
    border-bottom-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-right-radius: 1px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
}

.resourceBox {
    width: auto;
    height: auto;
    flex-direction: row-reverse;
    align-items: center;
    justify-content: space-between;
    font-size: initial;
    margin: 0;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    border-width: 6px;
    border-color: var(--outerColor);
    background-color: var(--innerColor);
}

.resourceCount {
    font-size: 18px;
    color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
    min-width: 90px;
    -unity-text-align: middle-right;
}

.resourceIcon {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    width: 20px;
    margin-right: 5px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    align-items: center;
    justify-content: center;
}

.commandButtonActive .buttonIcon {
    -unity-background-image-tint-color: rgb(212, 81, 81);
}

.activeAbility {
    border-left-color: rgb(145, 214, 86);
    border-right-color: rgb(145, 214, 86);
    border-top-color: rgb(145, 214, 86);
    border-bottom-color: rgb(145, 214, 86);
}

.techDescription {
    flex-wrap: wrap;
    flex-direction: column;
    max-width: none;
    white-space: normal;
    width: auto;
    flex-grow: 0;
    flex-shrink: 1;
    -unity-text-align: upper-left;
    color: rgb(255, 255, 255);
    border-left-color: rgb(75, 75, 75);
    border-right-color: rgb(75, 75, 75);
    border-top-color: rgb(75, 75, 75);
    border-bottom-color: rgb(75, 75, 75);
    border-bottom-width: 2px;
    padding-bottom: 5px;
}

.techName {
    flex-wrap: wrap;
    flex-direction: column;
    max-width: none;
    white-space: normal;
    width: auto;
    -unity-font-style: bold;
    flex-grow: 0;
    padding-right: 15px;
}

.lockName {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 5px;
    padding-right: 0;
    padding-bottom: 0px;
    padding-left: 0;
    flex-direction: row;
    flex-wrap: nowrap;
}

.costGroup {
    flex-direction: row;
    margin-top: 5px;
    margin-right: 0;
    margin-bottom: 5px;
    margin-left: 10px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    height: auto;
    justify-content: flex-start;
    align-self: center;
    -unity-text-align: middle-center;
    align-items: center;
    max-width: none;
    width: auto;
}

.costIcon {
    margin-top: 0;
    margin-right: 5px;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 15px;
    height: 15px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
}

.manaIcon {
    background-color: var(--borderColor);
}

.cooldownIcon {
}

.CommandsPanel {
    top: 0;
    position: absolute;
    width: 40px;
    height: 100%;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
    justify-content: flex-start;
    left: 0;
}

.light-border-color {
    border-left-color: rgb(183, 166, 133);
    border-right-color: rgb(183, 166, 133);
    border-top-color: rgb(183, 166, 133);
    border-bottom-color: rgb(183, 166, 133);
}

.border-params {
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.resource-wrapper {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 5px;
    margin-left: 5px;
    background-color: var(--borderColor);
}

.dark-border-color {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    width: 100%;
    border-left-color: rgb(117, 108, 92);
    border-right-color: rgb(117, 108, 92);
    border-top-color: rgb(117, 108, 92);
    border-bottom-color: rgb(117, 108, 92);
}

.emptySlot {
    background-color: var(--innerColor);
    border-color: var(--emptyButtonBorder);
}

.transport .emptySlot {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.25);
}

.inventoryBox {
    position: absolute;
    bottom: 0;
    right: 350px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    height: 275px;
    width: 182px;
    align-items: center;
    justify-content: center;
    align-self: center;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
}

.statusElement {
    width: 25px;
    height: 25px;
    margin: 5px;
    padding: 2px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 2px;
    border-bottom-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    background-color: var(--innerColor);
}

.playerIcon {
    position: relative;
    margin-left: 15px;
    margin-right: 15px;
    margin-top: 15px;
    margin-bottom: 15px;
    width: 100px;
    height: 100px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 270px;
    border-top-right-radius: 270px;
    border-bottom-right-radius: 270px;
    border-bottom-left-radius: 270px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    align-items: center;
    justify-content: center;
}

.playerIconInner {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 96px;
    height: 96px;
    border-top-left-radius: 270px;
    border-top-right-radius: 270px;
    border-bottom-right-radius: 270px;
    border-bottom-left-radius: 270px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.characterName {
    position: absolute;
    -unity-font-style: bold;
    font-size: 10px;
    bottom: -30px;
    align-items: center;
    justify-content: center;
}

.pingMiniMap {
    flex-grow: 1;
    background-image: url("project://database/Assets/StrategyCore/Textures/Core/Ping.png?fileID=2800000&guid=1e706b12fb1e13544b127f4edbf94c62&type=3#Ping");
    position: absolute;
    width: 35px;
    height: 35px;
}

.outerBorder {
    border-top-color: var(--borderInner);
    border-bottom-color: var(--emptySlotBorder);
    border-left-color: var(--backgroundColor);
    border-right-color: var(--darkBorder);
}

.innerBorder {
    border-top-color: var(--emptySlotBorder);
    border-bottom-color: var(--borderInner);
    border-left-color: var(--darkBorder);
    border-right-color: var(--backgroundColor);
}

.manaIcon {
    background-color: rgb(62, 121, 183);
}

.cooldownIcon {
    background-image: url("project://database/Assets/StrategyCore/Textures/Core/Cooldown.png?fileID=2800000&guid=b3ebcb42494511d4a801b84d6951c19a&type=3#Cooldown");
}

.inventoryMenu {
    border-color: var(--outerColor);
    border-width: 1px;
}

.inventoryMenu:hover {
    background-color: var(--outerColor);
}

.chat {
    background-color: var(--outerColor);
    border-color: var(--outerColor);
    color: rgb(255, 255, 255);
    border-radius: 3px;
    border-width: 1px;
}

.chat .unity-base-field__label {
    min-width: auto;
    padding: 10px;
}

.chat .unity-base-text-field__input {
    margin-left: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    --unity-cursor-color: rgb(255, 255, 255);
}

.buttonCD {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(46, 123, 205, 0.49);
    transform-origin: bottom;
    scale: 1 1;
    rotate: 0;
}

.menuButton:hover {
    background-color: var(--buttonBorder);
    border-color: var(--outerColor);
}

.TeamName {
    font-size: 24px;
    margin-bottom: 5px;
    color: rgba(255, 255, 255, 0.75);
}

.PlayerSlot {
    flex-grow: 0;
    height: 50px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    width: auto;
    align-items: center;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.57);
    -unity-text-align: upper-center;
}

.SlotClass {
    flex-grow: 1;
    height: auto;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    width: auto;
}

.SlotClass:hover {
    background-color: var(--buttonBorder);
    border-color: var(--outerColor);
}

.SlotExtraButton {
    padding-left: 25px;
    padding-right: 25px;
    flex-grow: 0;
}

.ListEntry {
    height: 50px;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 20px;
}

.RemoveButton {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    background-image: url("project://database/Assets/StrategyCore/Textures/UI/cancel.png?fileID=2800000&guid=68c9e1a1bfdc04b4b9a2ec64fc78dc60&type=3#cancel");
    flex-grow: 0;
    width: 55px;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
}

.FloatingMenuEntry {
    padding-top: 7px;
    padding-right: 7px;
    padding-bottom: 7px;
    padding-left: 7px;
    border-bottom-width: 0;
}
