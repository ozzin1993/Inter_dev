                <ui:VisualElement name="FoW" style="flex-grow: 0; background-color: rgb(56, 56, 56); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(89, 89, 89); border-right-color: rgb(89, 89, 89); border-top-color: rgb(89, 89, 89); border-bottom-color: rgb(89, 89, 89); margin-top: 15px; display: flex;">
                    <ui:Label tabindex="-1" text="FoW" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Header" style="font-size: 14px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgb(49, 49, 49); -unity-font-style: bold;" />
                    <ui:VisualElement name="Body" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                        <ui:Toggle label="Turn Off" binding-path="turnOff" />
                        <ui:FloatField label="Reveal Time" value="1" binding-path="revealTime" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="GameManager" style="flex-grow: 1;">
                    <ui:VisualElement name="Teams" style="flex-grow: 0; background-color: rgb(56, 56, 56); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(89, 89, 89); border-right-color: rgb(89, 89, 89); border-top-color: rgb(89, 89, 89); border-bottom-color: rgb(89, 89, 89); margin-top: 15px; display: flex;">
                        <ui:Label tabindex="-1" text="Teams" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Header" style="font-size: 14px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgb(49, 49, 49); -unity-font-style: bold;" />
                        <ui:VisualElement name="Body" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                            <ui:Toggle label="Choose Teams" binding-path="chooseTeams" />
                            <uie:PropertyField binding-path="teamsAndPlayers" label="Slots" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="Factions" style="flex-grow: 0; background-color: rgb(56, 56, 56); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(89, 89, 89); border-right-color: rgb(89, 89, 89); border-top-color: rgb(89, 89, 89); border-bottom-color: rgb(89, 89, 89); margin-top: 15px; display: flex;">
                        <ui:Label tabindex="-1" text="Factions" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Header" style="font-size: 14px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgb(49, 49, 49); -unity-font-style: bold;" />
                        <ui:VisualElement name="Body" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                            <uie:PropertyField binding-path="factionData" label="Factions" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="Win" style="flex-grow: 0; background-color: rgb(56, 56, 56); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(89, 89, 89); border-right-color: rgb(89, 89, 89); border-top-color: rgb(89, 89, 89); border-bottom-color: rgb(89, 89, 89); margin-top: 15px; display: flex;">
                        <ui:Label tabindex="-1" text="Win Conditions" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Header" style="font-size: 14px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgb(49, 49, 49); -unity-font-style: bold;" />
                        <ui:VisualElement name="Body" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                            <uie:PropertyField binding-path="allUnitsBuildingsDead" label="Units and Buildings dead" />
                            <uie:PropertyField binding-path="allBuildingsDestroyed" label="Only Buildings destroyed" />
                            <uie:PropertyField binding-path="specificUnitsDead" label="Specific Units Dead" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="GameSetup" style="flex-grow: 0; background-color: rgb(56, 56, 56); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(89, 89, 89); border-right-color: rgb(89, 89, 89); border-top-color: rgb(89, 89, 89); border-bottom-color: rgb(89, 89, 89); margin-top: 15px; display: flex;">
                        <ui:Label tabindex="-1" text="Game Setup" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Header" style="font-size: 14px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgb(49, 49, 49); -unity-font-style: bold;" />
                        <ui:VisualElement name="Body" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                            <ui:Toggle label="Includes Invisible" binding-path="gameIncludesInvisible" name="Invisible" />
                            <ui:Toggle label="Show Buildings FoW" binding-path="showBuildingsInFow" />
                            <ui:Toggle label="Cancel Full Return" binding-path="constructionCancelFullReturn" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="Rewards" style="flex-grow: 0; background-color: rgb(56, 56, 56); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(89, 89, 89); border-right-color: rgb(89, 89, 89); border-top-color: rgb(89, 89, 89); border-bottom-color: rgb(89, 89, 89); margin-top: 15px; display: flex;">
                        <ui:Label tabindex="-1" text="Rewards" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Header" style="font-size: 14px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgb(49, 49, 49); -unity-font-style: bold;" />
                        <ui:VisualElement name="Body" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                            <ui:Toggle label="Spread XP" binding-path="spreadEXP" />
                            <ui:FloatField label="XP Spread Range" value="42.2" binding-path="spreadRange" />
                            <ui:Toggle label="Equal XP" binding-path="equalEXP" />
                            <ui:FloatField label="Ally Kill Reward" value="42.2" binding-path="allyKillReward" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="Shop" style="flex-grow: 0; background-color: rgb(56, 56, 56); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(89, 89, 89); border-right-color: rgb(89, 89, 89); border-top-color: rgb(89, 89, 89); border-bottom-color: rgb(89, 89, 89); margin-top: 15px; display: flex;">
                        <ui:Label tabindex="-1" text="Shop" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Header" style="font-size: 14px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgb(49, 49, 49); -unity-font-style: bold;" />
                        <ui:VisualElement name="Body" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                            <ui:FloatField label="Shop Radius" value="3" binding-path="shopRadius" />
                            <ui:FloatField label="Price Reduction" value="0.5" binding-path="sellPriceReduction" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="GameResources" style="flex-grow: 0; background-color: rgb(56, 56, 56); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(89, 89, 89); border-right-color: rgb(89, 89, 89); border-top-color: rgb(89, 89, 89); border-bottom-color: rgb(89, 89, 89); margin-top: 15px;">
                    <ui:Label tabindex="-1" text="Scene Resources" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Header" style="font-size: 14px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgb(49, 49, 49); -unity-font-style: bold;" />
                    <ui:VisualElement name="Body" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                        <uie:PropertyField label="Resources" binding-path="gameResources" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Sound" style="flex-grow: 0; background-color: rgb(56, 56, 56); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(89, 89, 89); border-right-color: rgb(89, 89, 89); border-top-color: rgb(89, 89, 89); border-bottom-color: rgb(89, 89, 89); margin-top: 15px;">
                    <ui:Label tabindex="-1" text="Sound" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Header" style="font-size: 14px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgb(49, 49, 49); -unity-font-style: bold;" />
                    <ui:VisualElement name="Body" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                        <ui:IntegerField label="Max Sound Count" value="4" binding-path="maxSoundCount" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:Button text="Delete" parse-escape-sequences="true" display-tooltip-when-elided="true" name="DeleteButton" style="padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; height: 30px; position: absolute; top: 15px; right: 15px;" />
    </ui:VisualElement>
</ui:UXML>
