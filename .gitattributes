# ============================================================
# Default: let Git normalize text files, auto-detect the rest.
# ============================================================
* text=auto

# C# / shader / config source — explicit text + diff hints
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text
*.compute   text
*.uxml      text
*.uss       text
*.json      text
*.txt       text
*.md        text
*.xml       text
*.yml       text
*.yaml      text

# ============================================================
# Unity YAML assets — TEXT + smart merge (UnityYAMLMerge).
# This replaces the old "binary" marking so concurrent edits
# can auto-merge instead of producing hard conflicts.
# Requires the one-time merge driver registration (see README note).
# ============================================================
*.unity              merge=unityyamlmerge eol=lf
*.prefab             merge=unityyamlmerge eol=lf
*.asset              merge=unityyamlmerge eol=lf
*.meta               merge=unityyamlmerge eol=lf
*.mat                merge=unityyamlmerge eol=lf
*.anim               merge=unityyamlmerge eol=lf
*.controller         merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.physicMaterial     merge=unityyamlmerge eol=lf
*.physicsMaterial2D  merge=unityyamlmerge eol=lf
*.preset             merge=unityyamlmerge eol=lf
*.mask               merge=unityyamlmerge eol=lf
*.mixer              merge=unityyamlmerge eol=lf
*.terrainlayer       merge=unityyamlmerge eol=lf
*.brush              merge=unityyamlmerge eol=lf
*.spriteatlas        merge=unityyamlmerge eol=lf
*.lighting           merge=unityyamlmerge eol=lf
*.signal             merge=unityyamlmerge eol=lf
*.guiskin            merge=unityyamlmerge eol=lf

# Generated input actions are JSON, keep as text
*.inputactions       text

# ============================================================
# Binary asset types — never diff/merge, never touch EOLs.
# (git-lfs is NOT installed in this project; if you install it
#  later, swap "binary" for "filter=lfs diff=lfs merge=lfs -text".)
# ============================================================
*.psd     binary
*.psb     binary
*.fbx     binary
*.blend   binary
*.obj     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.bmp     binary
*.tga     binary
*.tif     binary
*.tiff    binary
*.exr     binary
*.hdr     binary
*.cubemap binary
*.wav     binary
*.mp3     binary
*.ogg     binary
*.aif     binary
*.aiff    binary
*.ttf     binary
*.otf     binary
*.dll     binary
*.so      binary
*.dylib   binary
*.a       binary
*.pdb     binary
*.mdb     binary
*.pdf     binary
*.unitypackage binary
