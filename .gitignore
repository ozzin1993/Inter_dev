# ============================================================
# Node: внешние зависимости (ставятся заново через npm install) — НЕ коммитить
# ============================================================
/node_modules/

# ============================================================
# Unity-generated / machine-local folders — NEVER commit
# ============================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Vv]REnv/
